# THE SILENCE INDEX - Environment Configuration
# Tagline: Because what is missing from history matters too.

# Database URL: SQLite (default local) or PostgreSQL (e.g. postgresql://user:pass@localhost:5432/silence_index)
DATABASE_URL=sqlite:///./silence_index.db

# Optional European Museum API Key (Harvesting works offline and via Wikimedia Commons without key)
EUROPEANA_API_KEY=

# LLM Explanation Feature Flag (0 = Deterministic templates [default], 1 = Gated wording)
LLM_EXPLAIN=0
GEMINI_API_KEY=

# Semantic Embeddings Feature Flag (0 = RapidFuzz token matching [default], 1 = Multilingual Sentence-Transformers)
ENABLE_EMBEDDINGS=0

# Frontend & API Networking
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

